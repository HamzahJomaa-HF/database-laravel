APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Microsoft Graph (innoge/laravel-msgraph-mail) — used when MAIL_MAILER=microsoft-graph.
# Requires an Azure AD app registration with Mail.Send application permission.
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=

# Always notified on every activity creation, regardless of selected focal points (comma-separated)
ACTIVITY_ALWAYS_NOTIFY_EMAILS=

# Detailed support groups (comma-separated)
SUPPORT_EMAIL_DMESC=
SUPPORT_EMAIL_LOGPROC=
SUPPORT_EMAIL_COMMS=
# Extra recipient when Live Streaming, Hardware Needed or WiFi Access is ticked
SUPPORT_EMAIL_TECHNICAL=

# Emailed when "President Involved" is ticked (comma-separated, 2 addresses)
PRESIDENT_INVOLVED_EMAILS=

# Venue recipients (comma-separated) - emailed when the activity's venue matches
VENUE_EMAIL_BEIRUT_OFFICE=
VENUE_EMAIL_NATIONAL_STATE_ACADEMY=
VENUE_EMAIL_KHAN_EL_FRANJ=
VENUE_EMAIL_OUTREACH_LEADERSHIP=
VENUE_EMAIL_TAAMIR_EIN_EL_HILWEH=
VENUE_EMAIL_VOCATIONAL_TRAINING=
VENUE_EMAIL_CISCO_ACADEMY=
VENUE_EMAIL_SOCIAL_MEDICAL_CENTER=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
